<UserControl x:Class="RuneFoundry.Editor.Views.CampaignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RuneFoundry.UI;assembly=RuneFoundry.UI"
             xmlns:local="clr-namespace:RuneFoundry.Editor.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:FindingColourConverter x:Key="FindingColour"/>
        <local:BoolToSpaceConverter x:Key="BoolToSpace"/>

        <!-- One condition, as one line of a sentence: who, does what, to what, how many.
             The fields a kind does not use are hidden rather than collapsed, so every row
             keeps the same columns and a list of them reads as a table.

             Above the row, from the second one on, sits the word joining it to the one
             before. That word is the set's all-or-any, and it is a dropdown because this is
             the one place a reader would reach to change it. The first row has no line
             above it, since it is joined to nothing.

             The remove button is pinned to the right by a star column, so it is where it
             is whatever the row's width, and never off the edge of a narrower group. -->
        <DataTemplate x:Key="ConditionRow">
            <StackPanel>
                <ComboBox Width="64" HorizontalAlignment="Left"
                          ItemsSource="{Binding Joins}" DisplayMemberPath="Label"
                          SelectedItem="{Binding JoinChoice, Mode=TwoWay}"
                          Visibility="{Binding ShowJoin, Converter={StaticResource BoolToVis}}"
                          Margin="0,4,0,4"
                          ToolTip="Whether every condition in this set has to hold, or any one of them."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Width="118" ItemsSource="{Binding Players}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Player, Mode=TwoWay}"
                              Margin="{StaticResource GapRight}"
                              ToolTip="Whose things this counts."/>

                    <ComboBox Grid.Column="1" Width="164" ItemsSource="{Binding Kinds}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Kind, Mode=TwoWay}"
                              Margin="{StaticResource GapRight}"/>

                    <!-- Count before the thing: "own at least 4 Farms" is how it is said. -->
                    <ComboBox Grid.Column="2" Width="92" ItemsSource="{Binding Comparisons}" DisplayMemberPath="Label"
                              SelectedItem="{Binding OpChoice, Mode=TwoWay}"
                              Visibility="{Binding NeedsCount, Converter={StaticResource BoolToSpace}}"
                              Margin="{StaticResource GapRight}"/>

                    <TextBox Grid.Column="3" Width="52"
                             Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding NeedsCount, Converter={StaticResource BoolToSpace}}"
                             Margin="{StaticResource GapRight}"/>

                    <!-- Units, then groups, under headers. Every entry is a set of unit
                         types and is counted the same way; the header only says how broad
                         the set is. -->
                    <ComboBox Grid.Column="4" Width="200" ItemsSource="{Binding Counters}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Counter, Mode=TwoWay}"
                              Visibility="{Binding NeedsCounter, Converter={StaticResource BoolToSpace}}"
                              ToolTip="{Binding Counter.Label}"
                              Margin="{StaticResource GapRight}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Group}" Value="heading">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                        <Setter Property="Padding" Value="8,8,8,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBlock Grid.Column="5" Text="of which heroes" VerticalAlignment="Center"
                               Visibility="{Binding NeedsHeroes, Converter={StaticResource BoolToVis}}"
                               Margin="{StaticResource GapRight}"/>
                    <TextBox Grid.Column="6" Width="48"
                             Text="{Binding Heroes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding NeedsHeroes, Converter={StaticResource BoolToVis}}"
                             Margin="{StaticResource GapRight}"/>

                    <Button Grid.Column="8" Content="&#x2715;" Click="OnRemoveCondition"
                            Padding="{StaticResource SmallButtonPadding}" VerticalAlignment="Center"
                            ToolTip="Remove this condition"/>
                </Grid>

            </StackPanel>
        </DataTemplate>

        <!-- After ConditionRow on purpose: a StaticResource is resolved as the dictionary
             is read, so a template that names one defined further down throws when it is
             first instantiated. That is at the moment somebody adds a group, not at
             startup, which is the worst place for it to happen. -->
        <!-- A bracketed group: a raised panel inside the set, holding rows of its own that
             are joined by its own all-or-any. Drawn as a panel rather than with a bracket
             glyph, because a raised box is what a reader already understands as "these
             belong together" and a parenthesis is what a compiler understands. The word
             above it joins the whole group to what came before, exactly as a row's does. -->
        <DataTemplate x:Key="GroupBlock">
            <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8,10,10" Margin="0,4,0,0">
                <StackPanel>
                    <!-- The header: the word joining this group to what came before on the
                         left, and the group's close on the right, where a card keeps it. A
                         row's close sits inside the card and one step in, so the two are
                         told apart by where they are, not by what they say. -->
                    <Grid Margin="{StaticResource TightBelow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Width="64"
                                  ItemsSource="{Binding Joins}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding JoinChoice, Mode=TwoWay}"
                                  Visibility="{Binding ShowJoin, Converter={StaticResource BoolToSpace}}"/>
                        <Button Grid.Column="2" Content="&#x2715;" Click="OnRemoveGroup"
                                Padding="{StaticResource SmallButtonPadding}"
                                ToolTip="Remove this group and everything in it"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ConditionRow}"/>

                    <Button Content="Add a condition" Click="OnAddToGroup"
                            HorizontalAlignment="Left" Margin="{StaticResource TightAbove}"
                            Padding="{StaticResource SmallButtonPadding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>


        <!-- One template, two lists: a mission's briefing pages and the
             campaign's closing screen are the same thing to edit. -->
        <DataTemplate x:Key="BriefingPage">
                                    <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="{StaticResource GapBelow}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="_Replace the recording…" Click="OnReplaceSpeech"/>
                                                <MenuItem Header="Si_lence"
                                                          Click="OnSilenceSpeech"
                                                          ToolTip="The page shows its text with no speech."/>
                                                <Separator/>
                                                <MenuItem Header="Reset to _game default"
                                                          Click="OnResetSpeech"
                                                          IsEnabled="{Binding SpeechOverridden}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       FontSize="{StaticResource SmallText}" Margin="{StaticResource GapBelow}"/>

                                            <TextBox Text="{Binding Text, Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnTextEdited"
                                                     LostFocus="OnTextLostFocus"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                                     VerticalScrollBarVisibility="Auto" Margin="{StaticResource GapBelow}"/>

                                            <TextBlock Text="{Binding SpeechPath}" FontFamily="Consolas"
                                                       FontSize="{StaticResource SmallText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SpeechState}" Style="{StaticResource Dim}"
                                                       FontSize="{StaticResource SmallText}" Margin="{StaticResource RowInset}"/>
                                            <WrapPanel>
                                                <Button Click="OnPlaySpeech" Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"
                                                        MinWidth="72">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="11" Height="11" Margin="{StaticResource GapRight}"
                                                              VerticalAlignment="Center" Stretch="Uniform"
                                                              Fill="{DynamicResource Text}">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data"
                                                                            Value="{StaticResource IconPlay}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}"
                                                                                     Value="True">
                                                                            <Setter Property="Data"
                                                                                    Value="{StaticResource IconSquare}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding PlayLabel}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="Replace…" Click="OnReplaceSpeech"
                                                        Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                                <Button Content="Silence" Click="OnSilenceSpeech"
                                                        ToolTip="The page shows its text with no speech."
                                                        Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                                <Button Content="Reset" Click="OnResetSpeech"
                                                        IsEnabled="{Binding SpeechOverridden}"
                                                        ToolTip="Put the game's own recording back."
                                                        Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="230"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- The 52 missions, grouped the way the game presents them. -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Missions" Style="{StaticResource Heading}" Margin="{StaticResource GapBelow}"/>

                <ListBox Grid.Row="1" x:Name="MissionList"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="OnMissionSelected"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                            <!-- Right-clicking selects first, so the menu always acts on the
                                 mission under the pointer rather than on whatever was
                                 selected before. -->
                            <EventSetter Event="PreviewMouseRightButtonDown"
                                         Handler="OnMissionRightClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Reset this mission" Click="OnResetMission"
                                                  IsEnabled="{Binding CanReset}"
                                                  Visibility="{Binding IsMission,
                                                      Converter={StaticResource BoolToVis}}"
                                                  ToolTip="Puts this mission's map, briefing, text and scenario rule back the way the game shipped them."/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>

                                <!-- A campaign reads as the heading it used to be, and is a
                                     row like any other: one selection decides what the
                                     right-hand side shows. -->
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource Accent}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource SmallText}"
                                           Margin="{StaticResource LabelAbove}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsCampaign,
                                               Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal"
                                            ToolTip="{Binding Note}"
                                            Visibility="{Binding IsMission,
                                                Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Marker}" Width="12"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                      Background="Transparent"/>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
            <Grid>
                <TextBlock x:Name="Placeholder" Style="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource EmptyStateInset}"
                           Text="Select a mission to replace its map, briefing or speech."/>

                <ScrollViewer x:Name="CampaignDetail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="CampaignTitle" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="CampaignSubtitle" Style="{StaticResource Dim}"
                                   FontSize="{StaticResource SmallText}" TextWrapping="Wrap"/>

                        <!-- The game plays fourteen missions whatever a mod does, so where a
                             mod stops replacing them is worth saying before someone finds
                             out by playing. -->
                        <TextBlock x:Name="CampaignCoverage" Style="{StaticResource Dim}"
                                   FontSize="{StaticResource SmallText}" TextWrapping="Wrap"
                                   Margin="{StaticResource BlockBelow}"/>

                        <ui:BusyStrip x:Name="Busy" Margin="{StaticResource GapBelow}"/>

                        <ItemsControl x:Name="CampaignArtList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}"
                                            Margin="{StaticResource GapBelow}">
                                        <StackPanel>
                                            <DockPanel Margin="{StaticResource TightBelow}">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Reset all of it"
                                                        Click="OnResetCampaignArt"
                                                        IsEnabled="{Binding CanReset}"
                                                        Padding="{StaticResource ButtonPadding}"
                                                        Visibility="{Binding HasTitle,
                                                            Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Puts every picture in this act back, and its name with them."/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Coverage}"
                                                               Style="{StaticResource Dim}"
                                                               FontSize="{StaticResource SmallText}"
                                                               Visibility="{Binding HasCoverage,
                                                                   Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- An act's name is lettered over its title card,
                                                 so it belongs with the pictures rather than apart. -->
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     LostFocus="OnActTitleCommitted"
                                                     Margin="{StaticResource GapBelow}"
                                                     Visibility="{Binding HasTitle,
                                                         Converter={StaticResource BoolToVis}}"/>

                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="200" Margin="{StaticResource GapRight}">
                                                            <Border Height="110"
                                                                    BorderBrush="{DynamicResource Border}"
                                                                    BorderThickness="{StaticResource Hairline}"
                                                                    CornerRadius="{StaticResource Radius}"
                                                                    Margin="{StaticResource TightBelow}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource BgDeep}"/>
                                                                        <Style.Triggers>
                                                                            <!-- Dark line art needs
                                                                                 something to be dark
                                                                                 against. -->
                                                                            <DataTrigger Binding="{Binding WantsLightBacking}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource ArtLight}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal"
                                                                            HorizontalAlignment="Center">
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock Text="at rest"
                                                                                   DockPanel.Dock="Bottom"
                                                                                   HorizontalAlignment="Center"
                                                                                   Style="{StaticResource Dim}"
                                                                                   FontSize="{StaticResource SmallText}"
                                                                                   Visibility="{Binding HasPair,
                                                                                       Converter={StaticResource BoolToVis}}"/>
                                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                                               Margin="{StaticResource Tight}"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    </DockPanel>
                                                                    <DockPanel LastChildFill="True"
                                                                               Visibility="{Binding HasPair,
                                                                                   Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="pointed at"
                                                                                   DockPanel.Dock="Bottom"
                                                                                   HorizontalAlignment="Center"
                                                                                   Style="{StaticResource Dim}"
                                                                                   FontSize="{StaticResource SmallText}"/>
                                                                        <Image Source="{Binding HoveredThumbnail}" Stretch="Uniform"
                                                                               Margin="{StaticResource Tight}"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <TextBlock Text="{Binding Label}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="{StaticResource SmallText}"/>
                                                            <TextBlock Text="{Binding Shape}"
                                                                       Style="{StaticResource Dim}"
                                                                       FontSize="{StaticResource SmallText}"/>
                                                            <TextBlock Text="{Binding State}"
                                                                       Style="{StaticResource Dim}"
                                                                       FontSize="{StaticResource SmallText}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="{StaticResource TightBelow}"/>
                                                            <TextBlock Text="{Binding Note}"
                                                                       Style="{StaticResource Dim}"
                                                                       FontSize="{StaticResource SmallText}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="{StaticResource TightBelow}"
                                                                       Visibility="{Binding HasNote,
                                                                           Converter={StaticResource BoolToVis}}"/>

                                                            <WrapPanel>
                                                                <Button Content="Replace…"
                                                                        Click="OnReplaceCampaignArt"
                                                                        Padding="{StaticResource ButtonPadding}"
                                                                        Margin="{StaticResource ButtonGap}"/>
                                                                <Button Content="Export…"
                                                                        Click="OnExportCampaignArt"
                                                                        Padding="{StaticResource ButtonPadding}"
                                                                        Margin="{StaticResource ButtonGap}"
                                                                        ToolTip="RuneFoundry writes a pair as two files."/>
                                                                <Button Content="Reset"
                                                                        Click="OnResetSlot"
                                                                        IsEnabled="{Binding Changed}"
                                                                        Padding="{StaticResource ButtonPadding}"
                                                                        Margin="{StaticResource ButtonGap}"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="CampaignArtNote" Style="{StaticResource Dim}"
                                   FontSize="{StaticResource SmallText}" TextWrapping="Wrap"
                                   Margin="{StaticResource GapAbove}"/>

                        <!-- What the game shows after the last mission is won. It is a
                             briefing like any other, so it is edited like one. -->
                        <StackPanel x:Name="EpiloguePanel" Margin="{StaticResource SectionAbove}">
                            <TextBlock Text="Closing screen" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="EpilogueNote" Style="{StaticResource Dim}"
                                       TextWrapping="Wrap" FontSize="{StaticResource SmallText}"
                                       Margin="{StaticResource GapBelow}"/>
                            <ItemsControl x:Name="EpilogueList"
                                          ItemTemplate="{StaticResource BriefingPage}"/>
                        </StackPanel>

                        <!-- How long an act's card stays is really the fanfare's length,
                             so it sits with the movies rather than with the pictures. -->
                        <local:ActTimingView x:Name="TimingPane"
                                             Margin="{StaticResource SectionAbove}"/>

                        <!-- What the campaign plays, under what it shows. -->
                        <local:MediaListView x:Name="MoviesPane"
                                             Margin="{StaticResource SectionAbove}"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="{StaticResource SectionRight}">

                        <TextBlock x:Name="MissionTitle" FontWeight="SemiBold" FontSize="{StaticResource SubheadText}"/>
                        <TextBlock x:Name="MissionSubtitle" Style="{StaticResource Dim}" Margin="{StaticResource SectionBelow}"/>

                        <!-- The text -->
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Text" Style="{StaticResource Heading}"
                                       VerticalAlignment="Center"/>
                            <ComboBox DockPanel.Dock="Right" x:Name="LocaleBox" Width="150"
                                      SelectionChanged="OnLocaleChanged" VerticalAlignment="Center"
                                      ToolTip="This box sets the language you edit."/>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="{StaticResource HeadingGap}">
                            <StackPanel>
                                <TextBlock x:Name="StringsState" Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"
                                           Margin="{StaticResource GapBelow}" TextWrapping="Wrap"/>

                                <Label Content="Mission name"/>
                                <TextBox x:Name="NameBox" TextChanged="OnTextEdited" LostFocus="OnTextLostFocus"
                                         Margin="{StaticResource GapBelow}"/>

                                <Label Content="Objectives (one per line, the game prefixes each with a dash)"/>
                                <TextBox x:Name="ObjectivesBox" TextChanged="OnTextEdited" LostFocus="OnTextLostFocus"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- The briefing, page by page, each with its recording -->
                        <TextBlock Text="Briefing" Style="{StaticResource Heading}"/>
                        <ItemsControl x:Name="PageList" Margin="{StaticResource HeadingGap}"
                                      ItemTemplate="{StaticResource BriefingPage}"/>

                        <TextBlock x:Name="Hint" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="{StaticResource SectionBelow}"
                                   Text="Text saves as you type, into this mod's copy of the language file."/>

                        <!-- The map -->
                        <TextBlock Text="Map" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="{StaticResource HeadingGap}">
                            <StackPanel>
                                <TextBlock x:Name="MapPath" FontFamily="Consolas" FontSize="{StaticResource SmallText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MapState" Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"
                                           Margin="{StaticResource RowInset}"/>
                                <WrapPanel>
                                    <Button Content="Replace…" Click="OnReplaceMap"
                                            ToolTip="Use a .PUD map of your own."
                                            Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                    <Button x:Name="MapResetButton" Content="Reset to game default"
                                            Click="OnResetMap" Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                    <Button x:Name="MapCopyButton" Content="Copy into the mod and edit"
                                            Click="OnCopyAndEditMap"
                                            ToolTip="Copy the game's map into this project, then open it."
                                            Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                    <Button x:Name="MapOpenButton" Content="Open" Click="OnOpenMap"
                                            ToolTip="Open this mod's copy of the map in whatever program handles .PUD files."
                                            Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                    <Button Content="Show in Explorer" Click="OnShowMap"
                                            Margin="{StaticResource ButtonGap}" Padding="{StaticResource ButtonPadding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- How the mission is won -->
                        <TextBlock Text="Scenario rules" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="{StaticResource HeadingGap}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}" Margin="{StaticResource GapBelow}"
                                           TextWrapping="Wrap"
                                           Text="Each campaign slot uses one of the game's scenario rules. Any mission can use any rule."/>

                                <!-- One of the game's rules is the default because it is the
                                     low-risk path: it needs nothing watching the game. -->
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource GapBelow}">
                                    <RadioButton x:Name="RuleFromGame" Content="Use a rule from the game"
                                                 Style="{StaticResource ModeChip}" IsChecked="True"
                                                 Checked="OnRuleModeChanged"/>
                                    <RadioButton x:Name="RuleOfMyOwn" Content="Write your own"
                                                 Style="{StaticResource ModeChip}" Margin="{StaticResource TightLeft}"
                                                 Checked="OnRuleModeChanged"/>
                                </StackPanel>

                                <ComboBox x:Name="ObjectiveBox" SelectionChanged="OnObjectiveChanged"
                                          MaxWidth="580" HorizontalAlignment="Left" MinWidth="440">
                                    <!-- Three lines per row: how it is won, how it is lost,
                                         and what it changes about the map before play.
                                         The same template draws the closed box, so the two
                                         detail lines collapse when there is no ComboBoxItem
                                         above them — which is only true in the closed box. -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="{StaticResource InlineField}">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>

                                                <ItemsControl x:Name="Detail" Margin="{StaticResource TightAbove}"
                                                              ItemsSource="{Binding Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="–" FontSize="{StaticResource SmallText}"
                                                                           Style="{StaticResource Dim}"
                                                                           Margin="{StaticResource TightRight}"/>
                                                                <TextBlock Text="{Binding}" FontSize="{StaticResource SmallText}"
                                                                           Style="{StaticResource Dim}"
                                                                           TextWrapping="Wrap" MaxWidth="430"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Value="{x:Null}"
                                                             Binding="{Binding RelativeSource={RelativeSource
                                                                 AncestorType=ComboBoxItem}}">
                                                    <Setter TargetName="Detail" Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Only for the counter objectives; see CampaignObjectives. -->
                                <StackPanel x:Name="DeliveryPanel" Visibility="Collapsed" Margin="{StaticResource GapAbove}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="How many must arrive" VerticalAlignment="Center"
                                                   Margin="{StaticResource GapRight}"/>
                                        <TextBox x:Name="DeliveryCount" Width="60"
                                                 TextChanged="OnDeliveryChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource GapAbove}">
                                        <TextBlock Text="…of which Heroes (odd numbers only)"
                                                   VerticalAlignment="Center" Margin="{StaticResource GapRight}"/>
                                        <TextBox x:Name="DeliveryHeroes" Width="60"
                                                 TextChanged="OnDeliveryChanged"
                                                 ToolTip="Heroes count towards the total."/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="ObjectiveAlso" Style="{StaticResource Dim}"
                                           FontSize="{StaticResource SmallText}" TextWrapping="Wrap" Margin="{StaticResource GapAbove}"/>

                                <TextBlock x:Name="ObjectiveNeeds" Style="{StaticResource Dim}"
                                           FontSize="{StaticResource SmallText}" TextWrapping="Wrap" Margin="{StaticResource GapAbove}"/>

                                <TextBlock x:Name="ObjectiveWarning" Style="{StaticResource Dim}"
                                           FontSize="{StaticResource SmallText}" TextWrapping="Wrap" Margin="{StaticResource GapAbove}"
                                           Foreground="{DynamicResource Bad}"/>

                                <!-- The author's own rules. Two lists, because a mission is
                                     won by one set of things and lost by another, and the
                                     two are edited apart. -->
                                <StackPanel x:Name="OwnRulesPanel" Visibility="Collapsed">
                                    <TextBlock Text="Won when" FontWeight="SemiBold"
                                               Margin="{StaticResource TightBelow}"/>

                                    <!-- The whole rule, read back as one sentence and kept
                                         current as it is edited. Brackets come out as
                                         "either ... or", which is the form a person would
                                         have written it in to begin with. -->
                                    <TextBlock x:Name="VictorySentence" TextWrapping="Wrap"
                                               Margin="{StaticResource GapBelow}"/>

                                    <!-- Each set is one card: its rows, its groups, then the
                                         two ways to add to it. A card around the whole set
                                         is what makes "won" and "lost" read as two things,
                                         and lets each row be a plain line inside it. -->
                                    <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
                                        <StackPanel>

                                            <ItemsControl x:Name="VictoryList" ItemTemplate="{StaticResource ConditionRow}"/>
                                            <ItemsControl x:Name="VictoryGroups" ItemTemplate="{StaticResource GroupBlock}"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="Add a condition" Click="OnAddVictory"
                                                        Padding="{StaticResource ButtonPadding}"/>
                                                <Button Content="Add a group" Click="OnAddVictoryGroup"
                                                        Padding="{StaticResource ButtonPadding}"
                                                        Margin="{StaticResource TightLeft}"
                                                        ToolTip="A bracketed set with its own all or any, for rules like this and (that or the other)."/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Lost when" FontWeight="SemiBold"
                                               Margin="{StaticResource SectionAbove}"/>
                                    <TextBlock x:Name="DefeatSentence" TextWrapping="Wrap"
                                               Margin="{StaticResource GapBelow}"/>

                                    <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
                                        <StackPanel>

                                            <ItemsControl x:Name="DefeatList" ItemTemplate="{StaticResource ConditionRow}"/>
                                            <ItemsControl x:Name="DefeatGroups" ItemTemplate="{StaticResource GroupBlock}"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="Add a condition" Click="OnAddDefeat"
                                                        Padding="{StaticResource ButtonPadding}"/>
                                                <Button Content="Add a group" Click="OnAddDefeatGroup"
                                                        Padding="{StaticResource ButtonPadding}"
                                                        Margin="{StaticResource TightLeft}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"
                                               TextWrapping="Wrap" Margin="{StaticResource SectionAbove}"
                                               Text="Nothing about a rule you write reaches the player. Say what to do in the Objectives box above."/>

                                    <TextBlock Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"
                                               TextWrapping="Wrap" Margin="{StaticResource TightAbove}"
                                               Text="A rule you write is watched while the game runs. Load a save with RuneFoundry closed and the mission falls back to the game's own rule, so tell players to keep it open."/>

                                    <ItemsControl x:Name="RuleFindings" Margin="{StaticResource GapAbove}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource SmallText}"
                                                           Foreground="{Binding Level, Converter={StaticResource FindingColour}}"
                                                           Margin="{StaticResource TightBelow}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- What the mission lets you build -->
                        <TextBlock Text="Build restrictions" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="{StaticResource HeadingGap}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}" Margin="{StaticResource GapBelow}"
                                           TextWrapping="Wrap"
                                           Text="The map decides what can be built on it. Set the allowed units, upgrades and spells in whichever editor you make the map with."/>

                                <TextBlock x:Name="TechState" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
