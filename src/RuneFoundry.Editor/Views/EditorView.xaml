<UserControl x:Class="RuneFoundry.Editor.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RuneFoundry.Editor"
             xmlns:views="clr-namespace:RuneFoundry.Editor.Views"
             xmlns:ui="clr-namespace:RuneFoundry.UI;assembly=RuneFoundry.UI"
             Background="{DynamicResource Bg}"
             AllowDrop="True" Drop="OnFilesDropped" DragOver="OnDragOver"
             PreviewKeyDown="OnKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:InverseBooleanConverter x:Key="NotBool"/>
        <ui:SectionStartsOpenConverter x:Key="SectionOpen"/>
        <ui:WaveSectionConverter x:Key="WaveSection"/>
        <!-- A row of the block editor shows one of these in each slot. They are separate
             templates, and the slot's style decides which one to build, because a block
             row that laid every control out and hid the ones it did not need was paying
             for four combo boxes, three text boxes and five buttons to show one or two
             of them: with virtualisation realising about thirty rows, that alone was
             most of the second this list took to appear. -->
        <DataTemplate x:Key="RowSubject">
            <ComboBox Width="210" Margin="{StaticResource GapRight}"
                      ItemsSource="{Binding SubjectChoices}"
                      SelectedItem="{Binding Subject, Mode=TwoWay}"
                      IsEnabled="{Binding CanEdit}"/>
        </DataTemplate>

        <DataTemplate x:Key="RowTargetNumber">
            <TextBox Width="210" Margin="{StaticResource GapRight}" Text="{Binding Target, Mode=TwoWay}"/>
        </DataTemplate>

        <DataTemplate x:Key="RowNumber">
            <TextBox Width="86" Margin="{StaticResource SectionRight}" Text="{Binding ValueText, Mode=TwoWay}"
                     IsReadOnly="{Binding IsReadOnly}"/>
        </DataTemplate>

        <!-- Goto aims at an absolute byte, which moves whenever a row above it changes
             length. Picking the section resolves to the offset of its first row. -->
        <DataTemplate x:Key="RowGoto">
            <ComboBox Width="240" Margin="{StaticResource SectionRight}"
                      ItemsSource="{Binding GotoTargets}"
                      SelectedItem="{Binding GotoTarget, Mode=TwoWay}"
                      IsEnabled="{Binding CanEdit}"/>
        </DataTemplate>

        <!-- Build-list positions are picked by name; a number means nothing here. -->
        <DataTemplate x:Key="RowBuilding">
            <ComboBox Width="280" Margin="{StaticResource SectionRight}"
                      ItemsSource="{Binding ValueChoices}"
                      SelectedItem="{Binding ValueChoice, Mode=TwoWay}"
                      IsEnabled="{Binding CanEdit}"/>
        </DataTemplate>

        <!-- Row actions, built when the pointer reaches the row: always-on buttons across
             170 rows read as clutter, and building them for every row costs more than the
             row itself. -->
        <DataTemplate x:Key="RowActions">
            <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionLeft}" VerticalAlignment="Center">
                <Button Style="{StaticResource RowAction}" Click="OnRowMoveUp" ToolTip="Move up">
                    <TextBlock Text="↑"/>
                </Button>
                <Button Style="{StaticResource RowAction}" Click="OnRowMoveDown" ToolTip="Move down">
                    <TextBlock Text="↓"/>
                </Button>
                <Button Style="{StaticResource RowAction}" Click="OnRowDuplicate" ToolTip="Duplicate">
                    <Path Style="{StaticResource IconPathDim}" Data="{StaticResource IconCopy}"
                          Width="11" Height="11"/>
                </Button>
                <Button Style="{StaticResource RowAction}" Click="OnRowInsertAfter"
                        ToolTip="Insert a row below">
                    <Path Style="{StaticResource IconPathDim}" Data="{StaticResource IconFilePlus}"
                          Width="11" Height="11"/>
                </Button>
                <Button Style="{StaticResource RowAction}" Click="OnRowDelete" ToolTip="Delete">
                    <Path Style="{StaticResource IconPathDim}" Data="{StaticResource IconTrash2}"
                          Width="11" Height="11"/>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RowActionKind">
            <ComboBox Width="140" Margin="{StaticResource GapRight}"
                      ItemsSource="{Binding Source={x:Static ui:AiBlock.Actions}}"
                      SelectedItem="{Binding ActionChoice, Mode=TwoWay}"
                      IsEnabled="{Binding CanChangeAction}"/>
        </DataTemplate>

        <Style x:Key="RowActionKindSlot" TargetType="ContentControl">
            <Setter Property="Content" Value="{Binding}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource RowActionKind}"/>
        </Style>

        <!-- A slot holds nothing until its condition is met: Content stays unset, so no
             control is built at all, rather than built and then collapsed. -->
        <Style x:Key="RowSubjectSlot" TargetType="ContentControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSubject}" Value="True">
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowSubject}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TargetIsNumber}" Value="True">
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowTargetNumber}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowValueSlot" TargetType="ContentControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowsNumber}" Value="True">
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowNumber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowsPosition}" Value="True">
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowNumber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowsGoto}" Value="True">
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowGoto}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowsBuilding}" Value="True">
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowBuilding}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowActionSlot" TargetType="ContentControl">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CanEdit}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource
                            AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowActions}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CanEdit}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource
                            AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="{Binding}"/>
                    <Setter Property="ContentTemplate" Value="{StaticResource RowActions}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A section header is one wide button: clicking anywhere on it opens or closes
             the section, and the chevron in the icon row says which way it will go. -->
        <Style x:Key="SectionHead" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{DynamicResource PanelRaised}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource BottomRule}"
                                CornerRadius="{StaticResource TabTopRadius}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- A stripe down the left edge: enough to read as the top of
                                     a section at a glance, without colouring the whole bar. -->
                                <Border Grid.Column="0" Background="{DynamicResource Accent}"
                                        CornerRadius="{StaticResource MarkerRadius}"/>
                                <ContentPresenter Grid.Column="1" Margin="{StaticResource TilePadding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chrome" Property="CornerRadius" Value="5"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Wider than a row action: these sit alone at the end of a header rather than in
             a tight cluster, and a header is a bigger thing to hit. -->
        <Style x:Key="SectionAction" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- What a row looks like when it is not the one being edited. Building the
             dropdowns for every visible row cost about a fifth of a second each time the
             lens opened, for controls that only one row at a time can be typed into. -->
        <DataTemplate x:Key="RowReading">
            <TextBlock Text="{Binding Line}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <DataTemplate x:Key="ClanRowTemplate">
            <Grid Margin="{StaticResource TightBelow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Colour}" VerticalAlignment="Center"
                           Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"/>
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         LostFocus="OnClanCommitted"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RowEditing">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Explanation}">
                <ContentControl Style="{StaticResource RowActionKindSlot}"/>
                <ContentControl Style="{StaticResource RowSubjectSlot}"/>
                <ContentControl Style="{StaticResource RowValueSlot}"/>
                <TextBlock Text="{Binding LoopNote}" FontSize="{StaticResource SmallText}"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                           Margin="{StaticResource TightLeft}"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Warning}" FontSize="{StaticResource SmallText}"
                           Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                           Margin="{StaticResource TightLeft}" TextTrimming="CharacterEllipsis"
                           MaxWidth="420">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="RowBodySlot" TargetType="ContentControl">
            <Setter Property="Content" Value="{Binding}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource RowReading}"/>
            <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding RelativeSource={RelativeSource
                    AncestorType=ListBoxItem}, Path=IsSelected}">
                    <Setter Property="ContentTemplate" Value="{StaticResource RowEditing}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding VisibleChildren}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Marker}" Width="12" FontFamily="Consolas"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <Path Style="{StaticResource IconPathDim}" Data="{Binding Icon}"
                      Width="13" Height="13" Margin="{StaticResource TightRight}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <Grid Margin="{StaticResource Block}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- These are tabs, so they sit on a rule like tabs rather than in a card. -->
        <Border x:Name="TabStrip" Grid.Row="0" Margin="{StaticResource SectionBelow}" Padding="{StaticResource BottomRule}"
                BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource BottomRule}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Four views of the same mod. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="FilesLens" Content="Files" Style="{StaticResource TabStripButton}"
                                 IsChecked="True" Checked="OnLensChanged" VerticalAlignment="Stretch"/>
                    <RadioButton x:Name="DetailsLens" Content="Mod details" Style="{StaticResource TabStripButton}"
                                 Checked="OnLensChanged" VerticalAlignment="Stretch"
                                 ToolTip="Name, version, author, and the files this mod replaces."/>
                    <RadioButton x:Name="CampaignLens" Content="Campaign" Style="{StaticResource TabStripButton}"
                                 Checked="OnLensChanged" VerticalAlignment="Stretch"
                                 ToolTip="Replace a mission's map, name, objectives, briefing and speech."/>
                    <RadioButton x:Name="UnitsLens" Content="Units" Style="{StaticResource TabStripButton}"
                                 Checked="OnLensChanged" VerticalAlignment="Stretch"
                                 ToolTip="This table sets each unit's cost, damage, armour and speed."/>
                    <RadioButton x:Name="UpgradesLens" Content="Upgrades" Style="{StaticResource TabStripButton}"
                                 Checked="OnLensChanged" VerticalAlignment="Stretch"
                                 ToolTip="This table sets the cost and the time of each upgrade."/>
                    <RadioButton x:Name="AiLens" Content="AI scripts" Style="{StaticResource TabStripButton}"
                                 Checked="OnLensChanged" VerticalAlignment="Stretch"
                                 ToolTip="This file holds the 84 computer-player scripts."/>
                    <RadioButton x:Name="IconsLens" Content="Icons" Style="{StaticResource TabStripButton}"
                                 Checked="OnLensChanged" VerticalAlignment="Stretch"
                                 ToolTip="This sheet holds unit portraits, buildings and command buttons."/>
                    <RadioButton x:Name="SpritesLens" Content="Sprites" Style="{StaticResource TabStripButton}"
                                 Checked="OnLensChanged" VerticalAlignment="Stretch"
                                 ToolTip="Which atlas each sprite draws from."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="{StaticResource GapBelow}">
                    <ComboBox x:Name="LaunchTargetBox" MinWidth="330" MaxWidth="380"
                              Margin="{StaticResource TightRight}" VerticalAlignment="Center"
                              DisplayMemberPath="Label"
                              ToolTip="This box sets what starts. You can start the game, or one mission."/>
                    <Button x:Name="TestButton" Content="Save &amp; test" Click="OnTestInGame"
                            Style="{StaticResource PrimaryButton}" MinWidth="130"
                            ToolTip="RuneFoundry applies this project and starts the game."/>
                </StackPanel>
            </Grid>
        </Border>

        <views:StartView Grid.Row="1" x:Name="StartPane" Visibility="Collapsed"/>
        <views:CampaignView Grid.Row="1" x:Name="CampaignPane" Visibility="Collapsed"/>
        <views:IconsView Grid.Row="1" x:Name="IconsPane" Visibility="Collapsed"/>
        <views:SpritesView Grid.Row="1" x:Name="SpritesPane" Visibility="Collapsed"/>

        <Grid Grid.Row="1" x:Name="DetailsPane" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <!-- Just the mod's own details now. The files it replaces are listed beside
                     the game's files, in Files, which is where you go looking for them. -->
                <ColumnDefinition Width="560" MinWidth="330"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- The name and the path used to sit in the title bar above every
                             view. They belong to the mod, not to the file you are editing. -->
                        <TextBlock x:Name="ProjectTitle" Text="No project open"
                                   FontWeight="SemiBold" FontSize="{StaticResource SubheadText}"/>
                        <TextBlock x:Name="ProjectSubtitle" Style="{StaticResource Dim}"
                                   Text="Create a project, then pick files from the game tree to replace."
                                   TextWrapping="Wrap" Margin="{StaticResource BlockBelow}"/>

                    <StackPanel x:Name="MetaPanel">
                        <Label Content="Name"/>
                        <TextBox x:Name="NameBox" TextChanged="OnMetaChanged" Margin="{StaticResource GapBelow}"/>
                        <Label Content="Id (folder-safe, used for updates)"/>
                        <TextBox x:Name="IdBox" TextChanged="OnMetaChanged" Margin="{StaticResource GapBelow}"
                                 FontFamily="Consolas" FontSize="{StaticResource SmallText}"/>
                        <Grid Margin="{StaticResource GapBelow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Version"/>
                                <TextBox x:Name="VersionBox" TextChanged="OnMetaChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Author"/>
                                <TextBox x:Name="AuthorBox" TextChanged="OnMetaChanged"/>
                            </StackPanel>
                        </Grid>
                        <Label Content="Description"/>
                        <TextBox x:Name="DescriptionBox" TextChanged="OnMetaChanged"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                 VerticalScrollBarVisibility="Auto" Margin="{StaticResource SectionBelow}"/>

                        <!-- The names of the sides. Keyed by campaign and player colour in
                             the language file, which is not something anyone would find by
                             looking, and the first thing a total conversion renames. -->
                        <Grid Margin="{StaticResource SectionBelow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="The sides" Style="{StaticResource Heading}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Reset to game defaults"
                                    Click="OnClanReset" Padding="{StaticResource ButtonPadding}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   FontSize="{StaticResource SmallText}"
                                   Margin="{StaticResource GapBelow}"
                                   Text="What each player colour is called. The game shows these in the score screen and when a side is defeated."/>

                        <Label Content="Human nations"/>
                        <ItemsControl x:Name="HumanClanList" ItemTemplate="{StaticResource ClanRowTemplate}"
                                      Margin="{StaticResource GapBelow}"/>

                        <Label Content="Orc clans"/>
                        <ItemsControl x:Name="OrcClanList" ItemTemplate="{StaticResource ClanRowTemplate}"
                                      Margin="{StaticResource GapBelow}"/>

                        <Label Content="Expansion clans"/>
                        <ItemsControl x:Name="ExpansionClanList" ItemTemplate="{StaticResource ClanRowTemplate}"
                                      Margin="{StaticResource SectionBelow}"/>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- What this mod changes about the game as a whole, rather than one campaign. -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:GameArtView x:Name="GameArtPane"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="1" x:Name="FilesPane">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="310" MinWidth="230"/>
                <ColumnDefinition x:Name="TreeGap" Width="10"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition x:Name="OverrideGap" Width="10"/>
                <ColumnDefinition x:Name="OverrideColumn" Width="330" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- The game's files, and under them the ones this mod replaces. Two lists that
                 answer the same question — what is in this mod, and what did it come from —
                 so they belong on one screen rather than a tab apart. -->
            <Grid x:Name="TreeCard" Grid.Column="0">
                <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Game files" Style="{StaticResource Heading}"/>
                    <Grid Grid.Row="1" Margin="{StaticResource GapBelow}">
                        <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged"/>
                        <TextBlock x:Name="FilterHint" Text="Filter…"
                                   Style="{StaticResource Dim}" IsHitTestVisible="False"
                                   Margin="{StaticResource GapLeft}" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 1,952 files: without virtualisation the tree builds a container for
                         every one of them, including the folders nobody has opened. -->
                    <TreeView Grid.Row="2" x:Name="GameTree" BorderThickness="{StaticResource NoBorder}" Background="Transparent"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              PreviewMouseRightButtonDown="OnTreeRightClick"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="FileMenu" Opened="OnFileMenuOpening">
                                <MenuItem x:Name="CtxSeed" Header="Copy and edit" Click="OnSeedOriginal">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxReplace" Header="Replace with file…" Click="OnReplaceFile">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconReplace}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="CtxReset" Header="Reset to game default" Click="OnRemoveOverride">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRotateCcw}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxReload" Header="Reload from disk" Click="OnReload">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefreshCw}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="CtxExplorer" Header="Show in Explorer" Click="OnShowInExplorer">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxOpen" Header="Open in default app" Click="OnOpenExternally">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFile}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="CtxCopyPath" Header="Copy path" Click="OnCopyPath"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
                </Border>

            </Grid>

            <!-- Preview -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Preview" Style="{StaticResource Heading}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PreviewPath" FontFamily="Consolas" FontSize="{StaticResource SmallText}"
                                       TextTrimming="CharacterEllipsis" Text="Nothing selected"
                                       VerticalAlignment="Center"/>

                            <!-- Whether this file belongs to the mod, said plainly rather
                                 than left to be inferred from which buttons are greyed. -->
                            <Border x:Name="ModBadge" Margin="{StaticResource GapLeft}" Padding="{StaticResource SmallButtonPadding}"
                                    CornerRadius="{StaticResource SmallRadius}" BorderThickness="{StaticResource Hairline}"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="ModBadgeText" FontSize="{StaticResource SmallText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="PreviewInfo" Style="{StaticResource Dim}" Margin="{StaticResource RowInset}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BgDeep}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource Hairline}" CornerRadius="{StaticResource SmallRadius}">
                        <Grid>
                            <Border Margin="{StaticResource Gap}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Visibility, ElementName=PreviewImage}">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                    <GeometryDrawing Brush="{StaticResource CheckerA}">
                                    <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,16,16"/>
                                    </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="{StaticResource CheckerB}">
                                    <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,8,8"/>
                                    <RectangleGeometry Rect="8,8,8,8"/>
                                    </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <MediaElement x:Name="PreviewVideo" Visibility="Collapsed"
                                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          Stretch="Uniform" StretchDirection="DownOnly" Margin="{StaticResource Gap}"
                                          MediaOpened="OnVideoOpened" MediaEnded="OnVideoEnded"
                                          MediaFailed="OnVideoFailed"/>

                            <ScrollViewer x:Name="TextScroller" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" Margin="{StaticResource Micro}">
                                <TextBox x:Name="TextEditor" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="{StaticResource SmallText}" BorderThickness="{StaticResource NoBorder}"
                                         Background="Transparent" TextChanged="OnTextEdited"/>
                            </ScrollViewer>

                            <Grid x:Name="JsonPanel" Visibility="Collapsed" Margin="{StaticResource Micro}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="{StaticResource TileInset}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="JsonFilterBox" TextChanged="OnJsonFilterChanged"
                                                 Padding="{StaticResource DropDownPadding}"/>
                                        <TextBlock x:Name="JsonFilterHint" Text="Filter…"
                                                   Style="{StaticResource Dim}" IsHitTestVisible="False"
                                                   Margin="{StaticResource GapLeft}" VerticalAlignment="Center"/>
                                        <Button x:Name="JsonFilterClear" Click="OnJsonFilterClear"
                                                Visibility="Collapsed" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="{StaticResource TightRight}"
                                                Width="20" Height="20" Padding="{StaticResource NoBorder}"
                                                Background="Transparent" BorderThickness="{StaticResource NoBorder}"
                                                Foreground="{DynamicResource TextDim}"
                                                ToolTip="Clear the filter (Esc)">
                                            <Path Style="{StaticResource IconPathDim}" Data="{StaticResource IconX}"
                                                  Width="11" Height="11"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource GapLeft}">
                                        <Button Content="Expand all" Click="OnJsonExpandAll" Padding="{StaticResource TallButtonPadding}"/>
                                        <Button Content="Collapse" Click="OnJsonCollapseAll" Padding="{StaticResource TallButtonPadding}" Margin="{StaticResource TightLeft}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Virtualized so a 45,000-node atlas costs one screen of rows. -->
                                <ListView Grid.Row="1" x:Name="JsonRows"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Key" Width="260">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="{Binding Indent}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Click="OnJsonToggle" Focusable="False"
                                                                    Width="18" Padding="{StaticResource NoBorder}" Margin="{StaticResource TightRight}"
                                                                    Background="Transparent" BorderThickness="{StaticResource NoBorder}">
                                                                <Path Width="11" Height="11">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path" BasedOn="{StaticResource IconPathAccent}">
                                                                            <Setter Property="Data" Value="{StaticResource IconChevronRight}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="Data" Value="{StaticResource IconChevronDown}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Button>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}"
                                                                       FontFamily="Consolas" FontSize="{StaticResource SmallText}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Value" Width="280">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                      <Grid>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                 IsReadOnly="{Binding IsReadOnly}"
                                                                 FontFamily="Consolas" FontSize="{StaticResource SmallText}" Padding="{StaticResource TightPadding}"
                                                                 HorizontalAlignment="Stretch">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Bad}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                      </Grid>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Type" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Dim}"
                                                                   FontSize="{StaticResource SmallText}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="" Width="130">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}"
                                                                   FontSize="{StaticResource SmallText}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>

                            <Grid x:Name="AiPanel" Visibility="Collapsed" Margin="{StaticResource Micro}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox Grid.Column="0" x:Name="AiScriptList"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                                         SelectionChanged="OnAiScriptSelected"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The name, and nothing else. The slot number and
                                                 the instruction count were true but never useful:
                                                 what the reader is doing here is finding a script
                                                 by name. The dot marks one this mod has changed. -->
                                            <DockPanel Margin="{StaticResource Micro}" LastChildFill="True">
                                                <!-- A filled dot for a script this mod carries,
                                                     hollow for one changed since it was opened.
                                                     Finding the ones you wrote among 84 is what
                                                     the list is for. -->
                                                <TextBlock DockPanel.Dock="Right" Text="•"
                                                           Foreground="{DynamicResource Accent}"
                                                           Margin="{StaticResource GapLeft}" VerticalAlignment="Center"
                                                           ToolTip="This mod carries its own version"
                                                           Visibility="{Binding IsMine,
                                                               Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="◦"
                                                           Foreground="{DynamicResource Accent}"
                                                           Margin="{StaticResource GapLeft}" VerticalAlignment="Center"
                                                           ToolTip="Changed since this project was opened"
                                                           Visibility="{Binding IsEdited,
                                                               Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock DockPanel.Dock="Bottom"
                                                           Text="{Binding Budget}"
                                                           Style="{StaticResource Dim}"
                                                           FontSize="{StaticResource SmallText}"/>
                                                <TextBlock Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Note}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- What the sidebar could not fit: the bytes, and what
                                         they leave. There is width for it here. -->
                                    <TextBlock Grid.Row="0" x:Name="AiBudgetDetail"
                                               Style="{StaticResource Dim}"
                                               FontSize="{StaticResource SmallText}"
                                               Margin="{StaticResource TightBelow}"/>

                                    <!-- Blocks by default; the source view is there for
                                         anyone who would rather type it. -->
                                    <Grid Grid.Row="1" Margin="{StaticResource GapBelow}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <RadioButton x:Name="AiBlocksMode" Content="Blocks"
                                                         Style="{StaticResource ModeChip}" IsChecked="True"
                                                         Checked="OnAiModeChanged"/>
                                            <RadioButton x:Name="AiSourceMode" Content="Source"
                                                         Style="{StaticResource ModeChip}" Margin="{StaticResource TightLeft}"
                                                         Checked="OnAiModeChanged"/>

                                            <!-- Off by default: see AiLinker. -->
                                        </StackPanel>
                                        <StackPanel x:Name="AiBlockButtons" Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Add setup" Click="OnAiInsertSetup" Padding="{StaticResource ButtonPadding}"
                                                    ToolTip="Insert the 26-variable opening block."/>
                                            <Button x:Name="AiAddWaveButton" Content="Add wave…" Click="OnAiAddWave" Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"
                                                    ToolTip="Insert sleep, party size, wait and attack."/>
                                            <Button Content="Add" Click="OnAiAddBlock" Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"/>
                                            <Button Content="Clear and use this script" Click="OnAiUseSlot" Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"
                                                    ToolTip="Empty this script and leave the setup block, ready for one of your own."/>
                                            <Button Content="Copy" Click="OnAiCopyScript" Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"
                                                    ToolTip="Copy this script to the clipboard as text, to keep, share or paste into another slot."/>
                                            <Button Content="Replace…" Click="OnAiPasteScript" Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"
                                                    ToolTip="Paste a script in as text."/>
                                            <Button x:Name="AiMakeRoomButton" Content="Make room…" Click="OnAiMakeRoom"
                                                    Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"
                                                    ToolTip="Lay the file out again so a script can grow past its slot."/>
                                            <Button Content="Undo my changes" Click="OnAiRevertScript"
                                                    Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"
                                                    ToolTip="Reset this script only. Every other script keeps your changes."/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- IsVirtualizingWhenGrouping is the important one:
                                         WPF silently drops virtualization once a list is
                                         grouped, and every row here carries two dropdowns. -->
                                    <ListBox Grid.Row="2" x:Name="AiBlockList"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="OnAiRowMouseDown"
                                             PreviewMouseMove="OnAiRowMouseMove"
                                             DragOver="OnAiRowDragOver"
                                             Drop="OnAiRowDrop"
                                             HorizontalContentAlignment="Stretch"
                                             MaxWidth="1400" HorizontalAlignment="Stretch"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             VirtualizingPanel.CacheLength="0,1"
                                             VirtualizingPanel.CacheLengthUnit="Page"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Selection}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Fixed widths, left aligned: the value
                                                     belongs next to the field it sets, not
                                                     stretched to the far edge of the pane. -->
                                                <DockPanel Margin="{StaticResource Flush}" MinHeight="26" LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="{Binding OffsetLabel}" Width="44"
                                                               Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"
                                                               FontFamily="Consolas" TextAlignment="Right"
                                                               VerticalAlignment="Center" Margin="{StaticResource GapRight}"
                                                               ToolTip="Byte offset. This is what goto targets."/>

                                                    <ContentControl DockPanel.Dock="Right"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource RowActionSlot}"/>
                                                    <ContentControl DockPanel.Dock="Left"
                                                                    Style="{StaticResource RowBodySlot}"/>

                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                        <!-- Setup / Wave headers, so the shape of a script
                                             is visible without reading every row. -->
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <!-- Each section is its own box, so where one
                                                                     wave ends and the next begins is visible
                                                                     without reading the headers. -->
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <Border Background="{DynamicResource Panel}"
                                                                            BorderBrush="{DynamicResource Border}"
                                                                            BorderThickness="{StaticResource Hairline}" CornerRadius="{StaticResource LargeRadius}"
                                                                            Margin="{StaticResource GapBelow}"
                                                                            SnapsToDevicePixels="True">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>

                                                                            <ToggleButton x:Name="Head" Grid.Row="0"
                                                                                Style="{StaticResource SectionHead}"
                                                                                IsChecked="{Binding Name,
                                                                                    Converter={StaticResource SectionOpen},
                                                                                    Mode=OneTime}">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <StackPanel Grid.Column="0"
                                                                                                Orientation="Horizontal">
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   Foreground="{DynamicResource Accent}"
                                                                                                   FontWeight="SemiBold" FontSize="{StaticResource SmallText}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding ItemCount,
                                                                                                       StringFormat=' · {0} rows'}"
                                                                                                   Style="{StaticResource Dim}"
                                                                                                   FontSize="{StaticResource SmallText}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                    </StackPanel>

                                                                                    <!-- The icon row: whole-wave actions and
                                                                                         the collapse chevron, all shown only
                                                                                         while the header is under the pointer.
                                                                                         Setup and the closing loop are left
                                                                                         out of the wave actions: neither is a
                                                                                         thing you reorder. -->
                                                                                    <StackPanel Grid.Column="2"
                                                                                                Orientation="Horizontal"
                                                                                                VerticalAlignment="Center">
                                                                                        <StackPanel.Style>
                                                                                            <Style TargetType="StackPanel">
                                                                                                <Setter Property="Opacity" Value="0"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Value="True" Binding="{Binding
                                                                                                        RelativeSource={RelativeSource
                                                                                                            AncestorType=ToggleButton},
                                                                                                        Path=IsMouseOver}">
                                                                                                        <Setter Property="Opacity" Value="1"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </StackPanel.Style>

                                                                                        <StackPanel Orientation="Horizontal"
                                                                                                    Visibility="{Binding Name,
                                                                                                        Converter={StaticResource WaveSection}}"
                                                                                                    IsEnabled="{Binding Tag,
                                                                                                        RelativeSource={RelativeSource
                                                                                                            AncestorType=ListBox}}">
                                                                                            <Button Style="{StaticResource SectionAction}"
                                                                                                    Click="OnWaveMoveUp"
                                                                                                    ToolTip="Move this wave earlier">
                                                                                                <TextBlock Text="↑"/>
                                                                                            </Button>
                                                                                            <Button Style="{StaticResource SectionAction}"
                                                                                                    Click="OnWaveMoveDown"
                                                                                                    ToolTip="Move this wave later">
                                                                                                <TextBlock Text="↓"/>
                                                                                            </Button>
                                                                                            <Button Style="{StaticResource SectionAction}"
                                                                                                    Click="OnWaveDuplicate"
                                                                                                    ToolTip="Duplicate this wave">
                                                                                                <Path Style="{StaticResource IconPathDim}"
                                                                                                      Data="{StaticResource IconCopy}"
                                                                                                      Width="11" Height="11"/>
                                                                                            </Button>
                                                                                            <Button Style="{StaticResource SectionAction}"
                                                                                                    Click="OnWaveDelete"
                                                                                                    ToolTip="Delete this wave">
                                                                                                <Path Style="{StaticResource IconPathDim}"
                                                                                                      Data="{StaticResource IconTrash2}"
                                                                                                      Width="11" Height="11"/>
                                                                                            </Button>
                                                                                        </StackPanel>

                                                                                        <Button Style="{StaticResource SectionAction}"
                                                                                                Margin="{StaticResource BlockLeft}"
                                                                                                Click="OnSectionToggle">
                                                                                            <Path Width="11" Height="11">
                                                                                                <Path.Style>
                                                                                                    <Style TargetType="Path"
                                                                                                           BasedOn="{StaticResource IconPathDim}">
                                                                                                        <Setter Property="Data"
                                                                                                                Value="{StaticResource IconChevronRight}"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Value="True" Binding="{Binding
                                                                                                                RelativeSource={RelativeSource
                                                                                                                    AncestorType=ToggleButton},
                                                                                                                Path=IsChecked}">
                                                                                                                <Setter Property="Data"
                                                                                                                        Value="{StaticResource IconChevronDown}"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Path.Style>
                                                                                            </Path>
                                                                                        </Button>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </ToggleButton>

                                                                            <ItemsPresenter x:Name="Body" Grid.Row="1"
                                                                                            Margin="{StaticResource CardInset}"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger SourceName="Head" Property="IsChecked"
                                                                                 Value="False">
                                                                            <Setter TargetName="Body" Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                    </ListBox>

                                    <TextBox Grid.Row="2" x:Name="AiEditor" AcceptsReturn="True"
                                             AcceptsTab="True" TextChanged="OnAiTextEdited"
                                             FontFamily="Consolas" FontSize="{StaticResource SmallText}"
                                             Visibility="Collapsed"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"/>

                                    <TextBlock Grid.Row="3" x:Name="AiHint" Style="{StaticResource Dim}"
                                               Margin="{StaticResource IndentedAbove}" TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>

                            <Grid x:Name="DatPanel" Visibility="Collapsed" Margin="{StaticResource Micro}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="{StaticResource TightBelow}">
                                        <TextBox x:Name="DatFilterBox" TextChanged="OnDatFilterChanged"/>
                                        <TextBlock x:Name="DatFilterHint" Text="Filter…"
                                                   Style="{StaticResource Dim}" IsHitTestVisible="False"
                                                   Margin="{StaticResource GapLeft}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ListBox Grid.Row="1" x:Name="DatRecordList"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                                             SelectionChanged="OnDatRecordSelected"
                                             PreviewMouseRightButtonDown="OnOverrideRightClick"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ContextMenu>
                                            <ContextMenu Opened="OnDatRecordMenuOpening">
                                                <MenuItem x:Name="DatResetRecord"
                                                          Header="Reset to game default"
                                                          Click="OnResetDatRecord">
                                                    <MenuItem.Icon>
                                                        <Path Style="{StaticResource IconPath}"
                                                              Data="{StaticResource IconRotateCcw}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="{StaticResource Micro}">
                                                    <!-- Same dot the file tree uses for a
                                                         changed file, for the same reason. -->
                                                    <TextBlock DockPanel.Dock="Right" Text="●"
                                                               Foreground="{DynamicResource Accent}"
                                                               VerticalAlignment="Center" Margin="{StaticResource GlyphInset}"
                                                               ToolTip="Changed from the game's own table"
                                                               Visibility="{Binding Edited,
                                                                   Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Which record these fields belong to, in the game's
                                         own words. Without it the pane is a wall of numbers
                                         with the name only in the list you selected from. -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                Margin="{StaticResource IndentedRow}">
                                        <!-- The picture the game draws for this record, next
                                             to the name, which is how the game shows them. -->
                                        <ComboBox x:Name="DatIconBox" Width="72" Height="52"
                                                  Margin="{StaticResource GapRight}" Padding="{StaticResource Tight}"
                                                  VerticalAlignment="Center" MaxDropDownHeight="480"
                                                  SelectionChanged="OnDatIconChosen">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Width="470" Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Picture}" Width="52" Height="44"
                                                           Stretch="Uniform" Margin="{StaticResource NoBorder}"
                                                           ToolTip="{Binding Caption}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- The name is a string, not a number in the table,
                                             so editing it here writes the language file. -->
                                        <TextBox x:Name="DatRecordTitle" MinWidth="200"
                                                 FontSize="{StaticResource LabelText}" FontWeight="SemiBold"
                                                 VerticalAlignment="Center"
                                                 TextChanged="OnDatNameEdited"
                                                 LostFocus="OnDatNameCommitted"
                                                 ToolTip="The game shows this name."/>
                                        <TextBlock x:Name="DatRecordNote" Style="{StaticResource Dim}"
                                                   VerticalAlignment="Center" Margin="{StaticResource GapLeft}"/>
                                    </StackPanel>

                                    <!-- Everything about the record in one scrolling column:
                                         what it says, what it sounds like, then its numbers.
                                         These were two scrollers, one inside the other, and
                                         a pane with two bars down its right edge is a pane
                                         where neither one obviously moves what you meant. -->
                                    <ScrollViewer Grid.Row="1" Grid.RowSpan="2"
                                                  VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                    <StackPanel x:Name="DatTextPanel" Margin="{StaticResource IndentedScrollRow}">
                                        <TextBlock x:Name="DatTextLabel" Style="{StaticResource Dim}"
                                                   Text="Description" Margin="{StaticResource TightBelow}"/>
                                        <TextBox x:Name="DatTextBox" TextWrapping="Wrap"
                                                 AcceptsReturn="True" MinHeight="44"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="OnDatTextEdited"
                                                 LostFocus="OnDatTextCommitted"/>
                                    </StackPanel>

                                        <!-- The sounds this unit plays. Which sound a unit
                                             uses is fixed in the game, so what a mod changes
                                             is the file behind it.

                                             A sibling of the description, not a child of it.
                                             Nested inside, it went with the description when
                                             that was hidden — and it is hidden for every
                                             record the language file has no tooltip for,
                                             which is every hero. Their lines were on screen
                                             for nobody. -->
                                        <StackPanel x:Name="DatSoundPanel" Margin="{StaticResource IndentedScrollRow}">
                                            <TextBlock x:Name="DatSoundLabel" Style="{StaticResource Dim}"
                                                       Text="Sounds" Margin="{StaticResource TightBelow}"/>
                                            <ItemsControl x:Name="DatSoundList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="{StaticResource TightBelow}">
                                                            <DockPanel.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="_Replace with a file…"
                                                                              Click="OnReplaceUnitSound"/>
                                                                    <MenuItem Header="_Swap for another game sound…"
                                                                              Click="OnSwapUnitSound"/>
                                                                    <MenuItem Header="Si_lence"
                                                                              Click="OnSilenceUnitSound"
                                                                              ToolTip="This unit stops saying it."/>
                                                                    <Separator/>
                                                                    <MenuItem Header="Reset to _game default"
                                                                              Click="OnResetUnitSound"
                                                                              IsEnabled="{Binding Overridden}"/>
                                                                </ContextMenu>
                                                            </DockPanel.ContextMenu>

                                                            <Button DockPanel.Dock="Left"
                                                                    Style="{StaticResource RowAction}"
                                                                    Click="OnPlayUnitSound"
                                                                    Margin="{StaticResource GapRight}"
                                                                    ToolTip="Listen">
                                                                <Path Width="11" Height="11"
                                                                      Stretch="Uniform"
                                                                      Fill="{DynamicResource Text}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Data"
                                                                                    Value="{StaticResource IconPlay}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPlaying}"
                                                                                             Value="True">
                                                                                    <Setter Property="Data"
                                                                                            Value="{StaticResource IconSquare}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Button>

                                                            <TextBlock DockPanel.Dock="Right" Text="●"
                                                                       Foreground="{DynamicResource Accent}"
                                                                       VerticalAlignment="Center" Margin="{StaticResource GlyphInset}"
                                                                       ToolTip="Replaced by this mod"
                                                                       Visibility="{Binding Overridden,
                                                                           Converter={StaticResource BoolToVis}}"/>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="Reset" Padding="{StaticResource SmallButtonPadding}"
                                                                    Margin="{StaticResource TightLeft}"
                                                                    Click="OnResetUnitSound"
                                                                    IsEnabled="{Binding Overridden}"
                                                                    ToolTip="Put the game's own recording back."/>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="Silence" Padding="{StaticResource SmallButtonPadding}"
                                                                    Margin="{StaticResource TightLeft}"
                                                                    Click="OnSilenceUnitSound"
                                                                    ToolTip="This unit stops saying it."/>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="Replace…" Padding="{StaticResource SmallButtonPadding}"
                                                                    Click="OnReplaceUnitSound"
                                                                    ToolTip="Right-click the row for more."/>

                                                            <TextBlock Text="{Binding Label}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}"
                                                                       Margin="{StaticResource GapRight}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="DatSoundNote" Style="{StaticResource Dim}"
                                                       FontSize="{StaticResource SmallText}" TextWrapping="Wrap" Margin="{StaticResource TightAbove}"/>
                                        </StackPanel>

                                <ListBox x:Name="DatFieldList"
                                         HorizontalContentAlignment="Stretch"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,3"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True" Margin="{StaticResource Flush}">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Display}"
                                                           Width="190" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Help}"/>

                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Error}"
                                                           Foreground="{DynamicResource Bad}" FontSize="{StaticResource SmallText}"
                                                           VerticalAlignment="Center" Margin="{StaticResource GapLeft}"/>

                                                <!-- One control per field, chosen by the schema. -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Width="80" Text="{Binding Text, Mode=TwoWay}"
                                                             IsEnabled="{Binding IsEditable}"
                                                             Visibility="{Binding IsNumber,
                                                                 Converter={StaticResource BoolToVis}}"/>
                                                    <TextBox Width="80" Margin="{StaticResource TightLeft}"
                                                             Text="{Binding SecondText, Mode=TwoWay}"
                                                             IsEnabled="{Binding IsEditable}"
                                                             Visibility="{Binding HasSecond,
                                                                 Converter={StaticResource BoolToVis}}"/>

                                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsEditable}"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding IsToggle,
                                                                  Converter={StaticResource BoolToVis}}"/>

                                                    <ComboBox Width="230" ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Choice, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsEditable}"
                                                              Visibility="{Binding IsChoice,
                                                                  Converter={StaticResource BoolToVis}}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <ItemsControl ItemsSource="{Binding Flags}"
                                                                  Visibility="{Binding IsFlags,
                                                                      Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel MaxWidth="620"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Label}"
                                                                          IsChecked="{Binding IsSet, Mode=TwoWay}"
                                                                          IsEnabled="{Binding DataContext.IsEditable,
                                                                              RelativeSource={RelativeSource
                                                                                  AncestorType=ListBoxItem}}"
                                                                          Margin="{StaticResource TrailingLabel}" FontSize="{StaticResource SmallText}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="PreviewPlaceholder" Style="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource EmptyStateInset}"
                                       Text="Select a file in the tree."/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" x:Name="FrameBar" Visibility="Collapsed" Margin="{StaticResource GapAbove}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FramePlayButton" Click="OnFramePlay" MinWidth="76"
                                    Margin="{StaticResource GapRight}"
                                    ToolTip="Play the frames in order, over and over.">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="FramePlayIcon" Style="{StaticResource IconPath}"
                                          Data="{StaticResource IconPlay}" Margin="{StaticResource GapRight}"/>
                                    <TextBlock x:Name="FramePlayLabel" Text="Play"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportFramesButton" Content="Export all frames…"
                                    Click="OnExportAllFrames" Margin="{StaticResource TrailingBlock}"/>
                            <TextBlock Text="Frame" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center" Margin="{StaticResource GapRight}"/>
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="FrameSlider" Minimum="0" IsSnapToTickEnabled="True"
                                TickFrequency="1" ValueChanged="OnFrameChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="FrameLabel" Style="{StaticResource Dim}"
                                   VerticalAlignment="Center" Margin="{StaticResource GapLeft}" MinWidth="70"
                                   TextAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="{StaticResource SectionAbove}">

                    <!-- Shown after a map has been handed to an outside editor. The file is
                         the mod's own, so that editor writes straight into it and there is
                         nothing to import — only this, to re-read it once it has been saved. -->
                    <Border x:Name="ExternalEditStrip" Visibility="Collapsed"
                            Style="{StaticResource Card}" Padding="{StaticResource CardPadding}"
                            Margin="{StaticResource GapBelow}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reload it"
                                    Click="OnReloadExternalEdit"
                                    Padding="{StaticResource ButtonPadding}"/>
                            <TextBlock x:Name="ExternalEditNote" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="{StaticResource GapRight}"/>
                        </DockPanel>
                    </Border>

                    <WrapPanel>
                        <Button x:Name="SeedButton" Content="Copy and edit" Click="OnSeedOriginal"
                                Margin="{StaticResource ButtonGap}"/>
                        <Button x:Name="EditMapButton" Content="Edit map…" Click="OnEditMap"
                                Margin="{StaticResource ButtonGap}" Visibility="Collapsed"
                                ToolTip="RuneFoundry opens this map in your map editor.">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Choose a different map editor…"
                                              Click="OnChooseMapEditor"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="ReplaceButton" Content="Replace…" Click="OnReplaceFile"
                                Margin="{StaticResource ButtonGap}"/>
                        <Button x:Name="SaveTextButton" Content="Save changes" Click="OnSaveText"
                                Margin="{StaticResource ButtonGap}" Visibility="Collapsed"/>
                        <Button x:Name="PlaySoundButton" Click="OnPlayMedia" Margin="{StaticResource ButtonGap}"
                                Visibility="Collapsed" MinWidth="76">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="PlayIcon" Style="{StaticResource IconPath}"
                                      Data="{StaticResource IconPlay}" Margin="{StaticResource GapRight}"/>
                                <TextBlock x:Name="PlayLabel" Text="Play" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopSoundButton" Click="OnStopMedia" Margin="{StaticResource ButtonGap}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSquare}" Margin="{StaticResource GapRight}"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportPngButton" Content="Export PNG…" Click="OnExportPng"
                                Margin="{StaticResource ButtonGap}" Visibility="Collapsed"/>
                        <Button x:Name="OpenExternallyButton" Content="Open in player" Click="OnOpenExternally"
                                Margin="{StaticResource ButtonGap}" Visibility="Collapsed"/>
                        <Button x:Name="RemoveOverrideButton" Content="Reset to game default" Click="OnRemoveOverride"
                                Margin="{StaticResource ButtonGap}"/>
                        <Button Content="Reload" Click="OnReload" Margin="{StaticResource ButtonGap}"/>
                        <Button x:Name="ShowInExplorerButton" Content="Show in Explorer" Click="OnShowInExplorer"
                                Margin="{StaticResource ButtonGap}"/>
                    </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- What this mod replaces -->
<Border x:Name="OverrideCard" Grid.Column="4" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="OverrideHeading" Text="In this mod"
                                   Style="{StaticResource Heading}" Margin="{StaticResource RowInset}"/>
                        <ListBox Grid.Row="1" x:Name="OverrideList"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="OnOverrideSelected"
                                 PreviewMouseRightButtonDown="OnOverrideRightClick"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="OverrideMenu" Opened="OnOverrideMenuOpening">
                                    <MenuItem x:Name="OvrReplace" Header="_Replace…" Click="OnReplaceFile">
                                        <MenuItem.Icon>
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconReplace}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="OvrReset" Header="Reset to game default" Click="OnRemoveOverride">
                                        <MenuItem.Icon>
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRotateCcw}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="OvrReload" Header="Reload from disk" Click="OnReload">
                                        <MenuItem.Icon>
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefreshCw}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="OvrExplorer" Header="Show in Explorer" Click="OnShowInExplorer">
                                        <MenuItem.Icon>
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="OvrCopyPath" Header="Copy path" Click="OnCopyPath"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="{StaticResource SmallText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" x:Name="OverrideSummary" Style="{StaticResource Dim}"
                                   Margin="{StaticResource GapAbove}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="{StaticResource SectionAbove}" Padding="{StaticResource FieldPadding}">
            <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
