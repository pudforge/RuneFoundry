<UserControl x:Class="RuneFoundry.Editor.Views.MediaListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RuneFoundry.UI;assembly=RuneFoundry.UI">

    <!-- Declared here because a converter referenced but not declared kills the whole view
         at load, silently, with the window never appearing. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Title" Style="{StaticResource Heading}"/>

        <TextBlock Grid.Row="1" x:Name="Blurb" Style="{StaticResource Dim}" TextWrapping="Wrap"
                   FontSize="{StaticResource SmallText}" Margin="{StaticResource GapBelow}"/>

        <ui:BusyStrip Grid.Row="2" x:Name="Busy" Margin="{StaticResource GapBelow}"/>

        <ItemsControl Grid.Row="3" x:Name="CueList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}"
                            Margin="{StaticResource GapBelow}">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}"
                                       FontSize="{StaticResource SmallText}" TextWrapping="Wrap"
                                       Margin="{StaticResource GapBelow}"/>

                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="{StaticResource TightBelow}">
                                            <!-- Right-click carries the less-used controls, so
                                                 the row itself stays down to the two everyone
                                                 wants. -->
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Replace…" Click="OnReplace"/>
                                                    <MenuItem Header="Reset to game default"
                                                              Click="OnReset"
                                                              IsEnabled="{Binding Changed}"/>
                                                    <Separator Visibility="{Binding IsAudio,
                                                        Converter={StaticResource BoolToVis}}"/>
                                                    <MenuItem Header="Silence it"
                                                              Click="OnSilence"
                                                              Visibility="{Binding IsAudio,
                                                                  Converter={StaticResource BoolToVis}}"/>
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>

                                            <WrapPanel DockPanel.Dock="Right"
                                                       VerticalAlignment="Center">
                                                <Button Content="Replace…" Click="OnReplace"
                                                        Padding="{StaticResource ButtonPadding}"
                                                        Margin="{StaticResource ButtonGap}"/>
                                                <Button Content="Reset" Click="OnReset"
                                                        IsEnabled="{Binding Changed}"
                                                        Padding="{StaticResource ButtonPadding}"
                                                        Margin="{StaticResource ButtonGap}"/>
                                            </WrapPanel>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="{StaticResource SmallText}">
                                                    <Run Text="{Binding Label, Mode=OneWay}"
                                                         FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Path, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding State}"
                                                           Style="{StaticResource Dim}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource SmallText}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
