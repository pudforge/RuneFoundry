<UserControl x:Class="RuneFoundry.Editor.Views.SpritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RuneFoundry.UI;assembly=RuneFoundry.UI"
             Background="{DynamicResource Bg}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Block}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="{StaticResource GapBelow}">
                    <TextBlock Text="Sprites" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                    <ui:BusyStrip x:Name="Busy" Margin="{StaticResource GapAbove}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="{StaticResource GapBelow}">
                    <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged"/>
                    <TextBlock x:Name="FilterHint" Text="Filter…" Style="{StaticResource Dim}"
                               IsHitTestVisible="False" Margin="{StaticResource GapLeft}" VerticalAlignment="Center"/>
                </Grid>

                <ListBox Grid.Row="2" x:Name="SpriteList"
                             PreviewMouseRightButtonDown="OnSpriteRightClick" SelectionChanged="OnSpriteSelected"
                         MouseDoubleClick="OnSpriteDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="OnSpriteMenuOpening">
                            <MenuItem x:Name="SpriteSwapItem" Header="_Use another sprite's art…"
                                      Click="OnSpriteDoubleClick" InputGestureText="Double-click"/>
                            <Separator/>
                            <Separator/>
                            <MenuItem x:Name="SpriteExportItem" Header="_Export art…"
                                      Click="OnExportSprite"/>
                            <MenuItem x:Name="SpriteImportItem" Header="_Import art…"
                                      Click="OnImportSprite"/>
                            <Separator/>
                            <MenuItem x:Name="SpriteResetItem" Header="_Reset to game default"
                                      Click="OnResetSprite"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{StaticResource Micro}">
                                <TextBlock DockPanel.Dock="Right" Text="●"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center" Margin="{StaticResource GlyphInset}"
                                           ToolTip="Drawn with other art in this mod"
                                           Visibility="{Binding Changed,
                                               Converter={StaticResource BoolToVis}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Frames}"
                                           Style="{StaticResource Dim}" FontSize="{StaticResource SmallText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapLeft}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="{StaticResource GapBelow}">
                    <TextBlock x:Name="ChosenTitle" Style="{StaticResource Heading}"
                               Text="Nothing selected"/>
                    <TextBlock x:Name="ChosenNote" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource GapBelow}">
                    <TextBlock Text="Draw with" Style="{StaticResource Dim}"
                               VerticalAlignment="Center" Margin="{StaticResource GapRight}"/>
                    <ComboBox x:Name="SourceBox" Width="260" SelectionChanged="OnSourceChosen"
                              MaxDropDownHeight="460"/>
                    <CheckBox x:Name="AnyFrames" Content="Allow different frame counts"
                              Click="OnAnyFramesToggled" Margin="{StaticResource SectionLeft}"
                              VerticalAlignment="Center"
                              ToolTip="A sprite that runs out of frames has nothing to draw for the rest of its animation."/>
                    <Button x:Name="ExportButton" Content="Export art…"
                            Click="OnExportSprite" Margin="{StaticResource SectionLeft}"
                            ToolTip="RuneFoundry writes a grid you can paint on."/>
                    <Button x:Name="ImportButton" Content="Import art…"
                            Click="OnImportSprite" Margin="{StaticResource ButtonGap}"/>
                    <Button x:Name="ResetButton" Content="Reset to game default"
                            Click="OnResetSprite" Margin="{StaticResource SectionLeft}"/>
                    <TextBlock Text="Season" VerticalAlignment="Center"
                               Style="{StaticResource Dim}"
                               Margin="{StaticResource SectionLeft}"/>
                    <ComboBox x:Name="EraBox" MinWidth="110" VerticalAlignment="Center"
                              Margin="{StaticResource TightLeft}"
                              SelectionChanged="OnPreviewEraChanged"
                              ToolTip="This box picks the season to show."/>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource BgDeep}" BorderThickness="{StaticResource Hairline}"
                        BorderBrush="{DynamicResource Border}" CornerRadius="{StaticResource Radius}" Padding="{StaticResource Gap}">
                    <Grid>
                        <TextBlock x:Name="PreviewNote" Style="{StaticResource Dim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                                   Text="Pick a sprite to see its frames."/>
                        <ListBox x:Name="FrameList" BorderThickness="{StaticResource NoBorder}" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:VirtualizingWrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding}" Width="72" Height="72" Margin="{StaticResource Micro}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
