<UserControl x:Class="RuneFoundry.Editor.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Declared here because a converter referenced but not declared kills the whole view
         at load, silently, with the window never appearing. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="640"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Block}">
            <StackPanel>

                <TextBlock Text="RuneFoundry Campaign Editor"
                           FontSize="{StaticResource TitleText}" FontWeight="SemiBold"
                           Margin="{StaticResource TightBelow}"/>
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                           Margin="{StaticResource BlockBelow}"
                           Text="Open a mod to work on, or start a new one."/>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource BlockBelow}">
                    <Button Content="New project…" Click="OnNew"
                            Style="{StaticResource PrimaryButton}"
                            Padding="{StaticResource FieldPadding}" Margin="{StaticResource GapRight}"/>
                    <Button Content="Open a project…" Click="OnOpen"
                            Padding="{StaticResource FieldPadding}"/>
                </StackPanel>

                <TextBlock Text="Recent" Style="{StaticResource Heading}"
                           Margin="{StaticResource GapBelow}"/>

                <TextBlock x:Name="Empty" Style="{StaticResource Dim}" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="Nothing yet. A project you create or open shows up here."/>

                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The row is the button. A card with one Open button beside it
                                 was two targets for one action, and the obvious thing to
                                 click did nothing. -->
                            <Border Padding="{StaticResource CardPadding}"
                                    Margin="{StaticResource GapBelow}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnRowClicked"
                                    ToolTip="{Binding Path}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="_Open" Click="OnOpenRecent"
                                                  IsEnabled="{Binding Exists}"/>
                                        <Separator/>
                                        <MenuItem Header="_Remove from this list" Click="OnForget"
                                                  ToolTip="The project itself is not touched."/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Style.Triggers>
                                            <!-- Something has to say the row is a target. -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PanelRaised}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource Accent}"/>
                                            </Trigger>

                                            <!-- A project whose folder has gone cannot be
                                                 opened, so it stops looking like it can. -->
                                            <DataTrigger Binding="{Binding Exists}" Value="False">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Dim}"
                                               FontSize="{StaticResource SmallText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}"
                                               FontSize="{StaticResource SmallText}"
                                               Foreground="{DynamicResource Bad}"
                                               Visibility="{Binding Missing,
                                                   Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
