<Window x:Class="RuneFoundry.UI.ScriptText"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace this script"
        Width="640" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">

    <!-- A script is text, so the way to move one between slots, between mods or out of a
         forum post is to paste it. What is checked before the button lights is what the
         save would check: that it assembles, and that it fits the slot it is going into. -->
    <Grid Margin="{StaticResource Block}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource BlockBelow}">
            <TextBlock x:Name="Heading" Text="Replace this script"
                       FontSize="{StaticResource SubheadText}" FontWeight="SemiBold"
                       Margin="{StaticResource GapBelow}"/>

            <TextBlock x:Name="Note" TextWrapping="Wrap" Style="{StaticResource Dim}"
                       FontSize="{StaticResource SmallText}"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="Source"
                 AcceptsReturn="True" AcceptsTab="False"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextChanged="OnTextChanged"
                 Margin="{StaticResource GapBelow}"/>

        <TextBlock Grid.Row="2" x:Name="Verdict" TextWrapping="Wrap"
                   FontSize="{StaticResource SmallText}"
                   Margin="{StaticResource BlockBelow}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Accept" Content="Replace the script" Click="OnAccept"
                    IsDefault="True" IsEnabled="False"
                    Padding="{StaticResource ButtonPadding}"/>
            <Button Content="Cancel" Click="OnCancel" IsCancel="True"
                    Padding="{StaticResource ButtonPadding}" Margin="{StaticResource TightLeft}"/>
        </StackPanel>
    </Grid>
</Window>
