<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:RuneFoundry.UI">

    <!-- The dark set, and what paints before Palette applies the chosen theme. A cool
         grey with a little blue in it; see Palette.cs for the light set and the switch. -->
    <Color x:Key="BgDeepColor">#16181C</Color>
    <Color x:Key="BgColor">#1C1F24</Color>
    <Color x:Key="PanelColor">#22262C</Color>
    <Color x:Key="PanelRaisedColor">#2A2F37</Color>
    <Color x:Key="BorderColor">#363C46</Color>
    <Color x:Key="AccentColor">#6AA6F0</Color>
    <Color x:Key="AccentDimColor">#40628F</Color>
    <Color x:Key="TextColor">#E6E9EE</Color>
    <Color x:Key="TextDimColor">#9BA3AF</Color>
    <Color x:Key="GoodColor">#6FBF73</Color>
    <Color x:Key="WarnColor">#E0A030</Color>
    <Color x:Key="BadColor">#E0685E</Color>

    <!-- Text on the gold primary button. The chip is gold in both themes, so this stays
         dark in both; it is a token only so no raw hex is left in a style. -->
    <Color x:Key="OnAccentColor">#16181C</Color>

    <!-- Selection, and the two squares of the transparency checkerboard. Views were
         hard-coding these, which is exactly what breaks when the palette changes. -->
    <Color x:Key="SelectionColor">#2C3A4E</Color>
    <Color x:Key="CheckerAColor">#191C21</Color>
    <Color x:Key="CheckerBColor">#202429</Color>

    <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelRaised" Color="{StaticResource PanelRaisedColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="Selection" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="CheckerA" Color="{StaticResource CheckerAColor}"/>
    <SolidColorBrush x:Key="CheckerB" Color="{StaticResource CheckerBColor}"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- Body Strong from the Windows type ramp: 14 semibold, ordinary text colour. The
         ramp has no small-caps label style, and the guidance is sentence case for all UI
         text including titles, so these read as headings rather than shouted labels. The
         accent is kept for interactive things; colouring every section label with it made
         the window look striped. -->
    <!-- ===================== Design tokens =====================

         Every number the interface uses lives here, so a change is one edit rather than a
         hunt. Before this there were 48 distinct margins and `FontSize="12"` written out 44
         times: not a design, just the residue of writing screens one at a time.

         Spacing is a 4px grid, named for intent rather than size. Tight groups things that
         belong to one control, Gap separates controls, Section separates groups, Block
         separates parts of a screen. Micro is the 2px inset a thumbnail wants and nothing
         else does. -->

    <sys:Double x:Key="MicroSize">2</sys:Double>
    <sys:Double x:Key="TightSize">4</sys:Double>
    <sys:Double x:Key="GapSize">8</sys:Double>
    <sys:Double x:Key="SectionSize">12</sys:Double>
    <sys:Double x:Key="BlockSize">16</sys:Double>

    <Thickness x:Key="Micro">2</Thickness>
    <Thickness x:Key="Tight">4</Thickness>
    <Thickness x:Key="Gap">8</Thickness>
    <Thickness x:Key="Section">12</Thickness>
    <Thickness x:Key="Block">16</Thickness>

    <!-- One-sided gaps, which is what most margins actually are. -->
    <Thickness x:Key="TightAbove">0,4,0,0</Thickness>
    <Thickness x:Key="TightBelow">0,0,0,4</Thickness>
    <Thickness x:Key="TightLeft">4,0,0,0</Thickness>

    <!-- Steps in under a heading or a tick box, so the rows read as belonging to it. -->
    <Thickness x:Key="IndentTop">16,4,0,0</Thickness>
    <Thickness x:Key="TightRight">0,0,4,0</Thickness>

    <Thickness x:Key="GapAbove">0,8,0,0</Thickness>
    <Thickness x:Key="GapBelow">0,0,0,8</Thickness>
    <Thickness x:Key="GapLeft">8,0,0,0</Thickness>
    <Thickness x:Key="GapRight">0,0,8,0</Thickness>

    <Thickness x:Key="SectionAbove">0,12,0,0</Thickness>
    <Thickness x:Key="SectionBelow">0,0,0,12</Thickness>
    <Thickness x:Key="SectionLeft">12,0,0,0</Thickness>
    <Thickness x:Key="SectionRight">0,0,12,0</Thickness>

    <Thickness x:Key="BlockBelow">0,0,0,16</Thickness>

    <!-- A button in a row of buttons: gap to the right, and the same underneath so a
         wrapped row does not collapse onto the one above it. -->
    <Thickness x:Key="ButtonGap">0,0,8,4</Thickness>

    <!-- A heading and the block it introduces. -->
    <Thickness x:Key="HeadingGap">0,4,0,16</Thickness>

    <!-- Padding. -->
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="ButtonPadding">8,3</Thickness>
    <Thickness x:Key="SmallButtonPadding">8,2</Thickness>
    <Thickness x:Key="RowPadding">6,4</Thickness>
    <Thickness x:Key="TightPadding">4,2</Thickness>

    <!-- Type. The interface is one size with a smaller one for secondary text; the two
         larger sizes are headings. -->
    <sys:Double x:Key="SmallText">12</sys:Double>
    <sys:Double x:Key="LabelText">14</sys:Double>
    <sys:Double x:Key="SubheadText">15</sys:Double>
    <sys:Double x:Key="TitleText">18</sys:Double>

    <!-- Corners and rules. -->
    <CornerRadius x:Key="SmallRadius">3</CornerRadius>
    <CornerRadius x:Key="Radius">4</CornerRadius>
    <CornerRadius x:Key="LargeRadius">6</CornerRadius>

    <Thickness x:Key="Hairline">1</Thickness>
    <Thickness x:Key="NoBorder">0</Thickness>
    <Thickness x:Key="BottomRule">0,0,0,1</Thickness>

    <!-- Art. The glyph in a button, and the tile in the icon and sprite grids. -->
    <sys:Double x:Key="IconGlyph">11</sys:Double>
    <sys:Double x:Key="IconTile">72</sys:Double>

    <!-- Composites that mean something in one place each: the header's inset, an empty
         state's breathing room, a hanging indent, and the room a dropdown's arrow needs. -->
    <Thickness x:Key="HeaderInset">16,0,12,0</Thickness>
    <Thickness x:Key="EmptyStateInset">24</Thickness>
    <Thickness x:Key="BlockLeft">16,0,0,0</Thickness>
    <Thickness x:Key="DropDownPadding">8,4,24,4</Thickness>
    <Thickness x:Key="FieldPadding">12,8</Thickness>
    <Thickness x:Key="GlyphPadding">4,0</Thickness>
    <Thickness x:Key="TinyPadding">2</Thickness>
    <Thickness x:Key="TallButtonPadding">8,4</Thickness>

    <!-- Composite insets that recur: a row inside a card, and a glyph beside its label. -->
    <Thickness x:Key="RowInset">0,4,0,8</Thickness>
    <Thickness x:Key="GlyphInset">8,0,4,0</Thickness>
    <Thickness x:Key="TileInset">4,4,4,8</Thickness>
    <Thickness x:Key="CardInset">8,4,8,8</Thickness>
    <Thickness x:Key="Flush">0,0,0,0</Thickness>

    <!-- The last of them: single insets that mean one thing in one place. Named not because
         they repeat but because a number with no name is a number nobody dares change. -->
    <Thickness x:Key="IndentedRow">4,0,0,8</Thickness>

    <!-- The same, with room on the right for a scrollbar: a row of buttons that reaches the
         edge of a scrolling panel has its last button drawn under the bar. -->
    <Thickness x:Key="IndentedScrollRow">4,0,18,8</Thickness>
    <Thickness x:Key="LabelAbove">0,8,0,4</Thickness>
    <Thickness x:Key="InlineField">0,4,0,4</Thickness>
    <Thickness x:Key="TilePadding">8,8</Thickness>
    <Thickness x:Key="IndentedAbove">4,8,0,0</Thickness>
    <Thickness x:Key="TrailingLabel">0,0,12,4</Thickness>
    <Thickness x:Key="TrailingBlock">0,0,16,0</Thickness>
    <Thickness x:Key="FieldRow">0,4,0,12</Thickness>
    <Thickness x:Key="SpacedRow">0,8,0,8</Thickness>
    <Thickness x:Key="IndentedSection">4,12,0,0</Thickness>
    <Thickness x:Key="BlockAbove">0,16,0,0</Thickness>
    <Thickness x:Key="ChipMargin">8,4</Thickness>
    <Thickness x:Key="MenuItemInset">4,8,12,8</Thickness>

    <CornerRadius x:Key="TabTopRadius">5,5,0,0</CornerRadius>
    <CornerRadius x:Key="MarkerRadius">2,0,0,0</CornerRadius>
    <CornerRadius x:Key="TinyRadius">1</CornerRadius>

    <!-- A pale backing for artwork that is dark by nature.

         The campaign sketches are near-black line drawings on transparency, so on the app's
         own dark surface they read as an empty square. This one colour deliberately does not
         follow the theme: its job is to contrast with the art, and the art is dark in both. -->
    <Color x:Key="ArtLightColor">#D9D9DE</Color>
    <SolidColorBrush x:Key="ArtLight" Color="{StaticResource ArtLightColor}"/>

    <!-- ================== end design tokens ==================== -->

    <!-- The loading strip. Text and an indeterminate bar, because a bar alone does not
         say what is being waited for and text alone does not say that anything is happening. -->
    <Style TargetType="{x:Type local:BusyStrip}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BusyStrip}">
                    <Border Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="{StaticResource Hairline}"
                            CornerRadius="{StaticResource Radius}"
                            Padding="{StaticResource CardPadding}"
                            Margin="{StaticResource GapBelow}">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Message}"
                                       Foreground="{DynamicResource TextDim}"
                                       FontSize="{StaticResource SmallText}"
                                       Margin="{StaticResource TightBelow}"/>
                            <ProgressBar IsIndeterminate="True" Height="3"
                                         Background="Transparent"
                                         BorderThickness="{StaticResource NoBorder}"
                                         Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- Every list behaves the same: virtualised, recycling, and no horizontal scrollbar.
         Applied by name rather than to every ListBox, so a deliberately different list is
         still possible — but the default is the one the rest of the app uses. -->
    <Style x:Key="AppList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- A row in one of those lists. One padding, one alignment, everywhere. -->
    <Style x:Key="AppListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource RowPadding}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Padding" Value="0,0,0,2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3A322A"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentDim}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1A1613"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentDim}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="Height" Value="4"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Border}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <!-- Inside a menu the divider is inset from the frame; one that runs into the border
         reads as a crack in the panel instead of a break between groups. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Border}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Menus: WPF's stock menu chrome is light grey regardless of the app, so both the
         bar and the drop-down are templated here to match the rest of the surfaces. -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- A context menu draws its own popup chrome, which the MenuItem style below does
         not reach: without this the frame stays stock light grey around dark items. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource Hairline}"
                            CornerRadius="{StaticResource Radius}" Padding="{StaticResource Tight}" MinWidth="190"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A menu bar header is not a drop-down row. Giving both the same template is what
         made this bar look unlike a Windows one: every header reserved the width of an
         icon it did not have and of a shortcut column it could never fill, so "File" and
         "Game" sat far apart with dead space between them. -->
    <ControlTemplate x:Key="MenuBarItemTemplate" TargetType="MenuItem">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Radius}"
                SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter ContentSource="Header" Margin="{StaticResource ChipMargin}"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                       VerticalOffset="3" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource Hairline}"
                            CornerRadius="{StaticResource Radius}" Padding="{StaticResource Tight}" MinWidth="200">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelRaised}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelRaised}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A drop-down row: one narrow column for a check mark or an icon (an item never has
         both), the label, the shortcut, and the arrow that says there is a submenu. -->
    <ControlTemplate x:Key="MenuDropItemTemplate" TargetType="MenuItem">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Radius}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed"
                      Data="{DynamicResource IconCheck}" Stretch="Uniform" Width="11" Height="11"
                      Stroke="{DynamicResource Accent}" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon"
                                  Width="13" Height="13"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="{StaticResource MenuItemInset}"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>

                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource TextDim}" FontSize="{StaticResource SmallText}"
                           VerticalAlignment="Center" Margin="{StaticResource GapRight}"/>

                <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed"
                      Data="{DynamicResource IconChevronRight}" Stretch="Uniform"
                      Width="7" Height="7" Stroke="{DynamicResource TextDim}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Center" Margin="{StaticResource GapRight}"/>

                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                       HorizontalOffset="-3" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource Hairline}"
                            CornerRadius="{StaticResource Radius}" Padding="{StaticResource Tight}" MinWidth="180">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelRaised}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelRaised}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template" Value="{StaticResource MenuDropItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuBarItemTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuBarItemTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Grid tables: the stock GridView header is light grey and would sit oddly here. -->

    <!-- The drag handle that resizes a column. A custom header template has to carry this
         itself: GridViewColumnHeader finds it by name, and without it columns are fixed. -->
    <Style x:Key="ColumnGripper" TargetType="Thumb">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Padding="{StaticResource GlyphPadding}">
                        <Rectangle Width="1" Fill="{DynamicResource Border}" HorizontalAlignment="Right"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource BottomRule}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                               Style="{StaticResource ColumnGripper}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3A322A"/>
                        </Trigger>
                        <!-- The filler header past the last column has nothing to resize. -->
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,1"/>
        <!-- Without this the cell presenter shrinks to its content, so a field inside a
             column stays narrow no matter how wide the column is dragged. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#241F1A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lucide icons are stroke drawings on a 24x24 grid. Painting them with Fill turns
         them into blobs, so every icon goes through this: Stroke only, scaled to fit. -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource Text}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconPathDim" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="{DynamicResource TextDim}"/>
    </Style>

    <Style x:Key="IconPathAccent" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- ComboBox: WPF's stock one is a light control. Left unstyled in a dark app it
         renders the theme's pale text on its own pale chrome, which is unreadable. -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{DynamicResource BgDeep}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource Hairline}"
                            CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="{StaticResource GapRight}" Width="9" Height="9" Stretch="Uniform"
                              Stroke="{DynamicResource TextDim}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="{x:Null}"
                              Data="{DynamicResource IconChevronDown}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentDim}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDim}"/>
                            <Setter Property="Foreground" Value="#1B1815"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelRaised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!-- These three have to be ordinary bindings. TemplateBinding does
                             not follow SelectionBoxItemTemplate, which the ComboBox fills in
                             itself from DisplayMemberPath after the template is applied: the
                             closed box then fell back to ToString() and showed a record's
                             debug text ("DatOption { Value = 0 ... }") in place of its label. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{Binding SelectionBoxItem,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False"/>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource Hairline}"
                                    CornerRadius="{StaticResource Radius}" Padding="{StaticResource TinyPadding}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small segmented toggle, used where a pane has two ways to show the same thing. -->
    <!-- A tab: the label with an accent bar under the current one, the way Windows marks
         a selected tab. Both tab strips in the app use this, so the top-level switch and
         the editor's own views read as the same kind of control. -->
    <Style x:Key="TabStripButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,5,12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Radius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="Marker" Height="2" Width="18" CornerRadius="{StaticResource TinyRadius}"
                                    Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelRaised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A segmented switch between two ways of showing the same thing. Not a tab: it
         picks a representation, it does not move between views. -->
    <Style x:Key="ModeChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Radius}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="{StaticResource Hairline}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelRaised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentDim}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square button for actions that live on a list row. -->
    <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
    </Style>

    <!-- ToolTip: WPF's is a light control. The global TextBlock foreground is pale, so
         left alone every tooltip is white text on white. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <!-- Plain string content becomes a TextBlock here, which
                                     needs wrapping to respect MaxWidth. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

</ResourceDictionary>
